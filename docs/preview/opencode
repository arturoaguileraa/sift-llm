#!/usr/bin/env bash
# Mock of a harness (OpenCode-style) model picker, for the demo gif.
# Points at the Sift gateway and lists EVERY model discovered behind it.
# Display name = the provider's own model id + "PII secured by Sift".
set -euo pipefail

sel=$(gum choose --height 9 \
  --header "OpenCode  ·  select a model   (provider: sift @ localhost:8787)" \
  --cursor "❯ " \
  "claude-sonnet-4-6      PII secured by Sift" \
  "claude-opus-4-8        PII secured by Sift" \
  "llama-3.3-70b          PII secured by Sift" \
  "llama-3.1-8b-instant   PII secured by Sift")

name=$(printf '%s' "$sel" | awk '{print $1}')
printf '▸ %s ready  ·  every prompt PII secured by sift\n' "$name"
